{
  "info": {
    "_postman_id": "9f1a4d5e-2b7c-4a8e-9d3f-6c2b5a8e1d4f",
    "name": "Satullia API",
    "description": "Satullia backend API collection. Set {{base_url}} (https://api-satullia.danials.space) and {{file_url}} (https://file-satullia.danials.space). Login sets {{auth_token}} automatically via the 'Auth > Token' pre-script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://api-satullia.danials.space" },
    { "key": "file_url", "value": "https://file-satullia.danials.space" },
    { "key": "auth_token", "value": "" },
    { "key": "email", "value": "test@gmail.com" },
    { "key": "password", "value": "passWORD@@22" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/v1/auth/login (set {{auth_token}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "const t = d && (d.data && (d.data.access_token || d.data.token) || d.access_token || d.token);",
                  "if (t) pm.collectionVariables.set('auth_token', t);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "POST /api/v1/auth/verify-code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/verify-code", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "verify-code"] }
          }
        },
        {
          "name": "POST /api/v1/auth/resend-verify-code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/resend-verify-code", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "resend-verify-code"] }
          }
        },
        {
          "name": "POST /api/v1/auth/refresh-token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/refresh-token", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "refresh-token"] }
          }
        },
        {
          "name": "POST /api/v1/auth/signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"newuser@gmail.com\",\n  \"password\": \"StrongPass123!\",\n  \"username\": \"newuser\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/signup", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "signup"] }
          }
        }
      ]
    },
