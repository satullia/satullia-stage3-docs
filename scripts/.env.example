# ============================================================================
# Satullia API test scripts — configuration
# Copy this file to .env and adjust the values for your environment.
# ============================================================================

# ---- targets ---------------------------------------------------------------
BASE_URL=https://api-satullia.danials.space
FILE_URL=https://file-satullia.danials.space
# Folders/tabs service is NOT routed via the gateway in the current deployment.
# Point FOLDER_URL at the folder-service directly (e.g. http://localhost:8080).
FOLDER_URL=http://localhost:8080
# Post service registers routes WITHOUT the /api/v1 prefix (see notes in the docs).
POST_URL=http://localhost:3003

# ---- credentials -----------------------------------------------------------
TEST_EMAIL=test@gmail.com
TEST_PASSWORD=passWORD@@22
# Optional pre-issued tokens (if empty, scripts try login):
AUTH_TOKEN=
ADMIN_TOKEN=

# ---- test data -------------------------------------------------------------
TEST_DECK_IDS=(50 51)
TEST_FLASHCARD_ID=1
TEST_TAB_ID=1
TEST_FOLDER_ID=1
TEST_POST_ID=1
TEST_IMAGE=./test-image.png